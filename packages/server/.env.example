# Database
DATABASE_URL="file:./prisma/dev.db"
# Production (VPS): DATABASE_URL="file:/var/data/db.sqlite"

# JWT Secret (change this in production!)
JWT_SECRET="your-secret-key-change-in-production"

# Node Environment
NODE_ENV="development"

# Deployment identity: production | stage | development
# Stage runs with NODE_ENV=production, so APP_ENV is what distinguishes it.
# Controls the noindex header, /health output and the /api/debug/uploads gate.
# Defaults from NODE_ENV when unset — normally set by PM2, not here.
# APP_ENV="stage"

# Where uploaded files are written. Defaults to ./uploads in development and
# /var/data/uploads when NODE_ENV=production.
# UPLOADS_DIR="/var/data/stage/uploads"

# Short commit SHA reported by /health. Set by the deploy workflow.
# GIT_COMMIT=""

# Client URL (for email links)
CLIENT_URL="http://localhost:5173"

# Google OAuth (optional — «Sign in with Google» is hidden when unset)
# Create credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# Must exactly match an authorized redirect URI on the Google credential.
# Defaults to http://localhost:3001/api/auth/google/callback
# GOOGLE_CALLBACK_URL="https://ting.hpvel.no/api/auth/google/callback"
# Organization that Google sign-ins are enrolled in, by slug. Defaults to
# hpv-tingbibliotek. Set to an empty string to leave them without a membership.
# OAUTH_DEFAULT_ORG_SLUG="hpv-tingbibliotek"
# Feature flag: set to "false" to disable the Google login button and block the
# OAuth flow even when credentials are configured. Defaults to "true".
# GOOGLE_LOGIN_ENABLED="true"

# DB sync from prod (used by scripts/sync-db-from-prod.sh)
# VPS_HOST="deploy@your-server-ip"
# VPS_DB="/var/data/db.sqlite"   # optional, this is the default
# SSH_KEY="~/.ssh/id_rsa"        # optional, this is the default

# Email Configuration (optional)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="your-email@example.com"
# SMTP_PASS="your-password"
