#!/bin/sh
# Deployed copy lives at /usr/local/sbin/ting-deploy-migrate (root:root, 0755).
# This copy is tracked so the privileged part of the deploy is reviewable. To
# install or update it on the VPS:
#     sudo install -o root -g root -m 0755 scripts/ting-deploy-migrate \
#         /usr/local/sbin/ting-deploy-migrate
# The matching sudoers rule is in /etc/sudoers.d/ting-deploy:
#     deploy ALL=(root) NOPASSWD: /usr/local/sbin/ting-deploy-migrate
# Note the absence of a trailing `*`: this wrapper takes no arguments, so the
# rule should not permit any.
#
# Invoked by .github/workflows/deploy-vps.yml as:
#     sudo -n /usr/local/sbin/ting-deploy-migrate
# The sudoers rule names exactly this path — keep the two in step. This file is
# root-owned and not writable by the deploy user, so granting the rule does not
# let that user hand root an arbitrary command.
set -eu

# Prisma CLI reads packages/server/.env directly for DATABASE_URL; it never sees
# pm2's environment. Run from the package so that file is found.
cd /var/www/ting/packages/server

# Absolute paths rather than anything PATH- or HOME-derived. This VPS has no
# nvm: node is the system /usr/bin/node and pnpm is a global npm install at
# /usr/bin/pnpm, so the deploy user's ~/.local/share/pnpm holds only the store,
# not a binary. The NVM_DIR line in the deploy workflows is a no-op left over
# from a different setup — it survives only because /usr/bin is already on PATH.
# Under sudo, PATH comes from sudoers' secure_path, so nothing here should
# depend on the caller's environment.
#
# The package's own prisma binary, not `pnpm exec prisma`: pnpm runs a
# dependency-status check first and, finding the workspace out of date, tries to
# `pnpm install` — which aborts with ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY
# over SSH unless CI=true is in the environment, and sudo does not pass that
# through. A root-owned wrapper should not be reinstalling dependencies anyway;
# the workflow has already run `pnpm install --frozen-lockfile` by this point.
exec ./node_modules/.bin/prisma migrate deploy
